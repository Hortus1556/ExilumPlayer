+// Local additions (Exilum Player) - see OPL.h.
+
+float OPL::TakeVoicePeak(uint8 oplCh)
+{
+	if(oplCh >= kVoices)
+		return 0.0f;
+	// An operator's output is 13 bits, and a carrier is one operator.
+	constexpr float carrierFullScale = 4084.0f;
+	const float peak = m_voicePeak[oplCh] / carrierFullScale;
+	m_voicePeak[oplCh] = 0;
+	return peak;
