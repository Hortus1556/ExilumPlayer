+std::int32_t module_impl::set_channel_mute( std::int32_t channel, std::int32_t status ) {
+	if ( channel < 0 || channel >= m_sndFile->GetNumChannels() ) {
+		return -1;
+	}
+	OpenMPT::ModChannel & chn = m_sndFile->m_PlayState.Chn[channel];
+	// A channel the file itself mutes comes up with CHN_SYNCMUTE on the playing channel, not
+	// CHN_MUTE: it is run in silence, so that it is in step when it is brought back.
+	const bool muted = chn.dwFlags[OpenMPT::CHN_MUTE | OpenMPT::CHN_SYNCMUTE] || m_sndFile->ChnSettings[channel].dwFlags[OpenMPT::CHN_MUTE];
+	if ( status < 0 ) {
+		return muted ? 1 : 0;
+	}
+	const bool setMuted = status != 0;
+	// Whose mute it is: 1 is the listener's, 2 the file's own, put back as the file has it. They
+	// are the same silence, and differ in what a Scream Tracker module does with a channel it
+	// has switched off - see ModChannelSettings::userMuted.
+	const bool asFile = status == 2;
+	// As it is already: nothing to do, and a channel the file mutes stays the file's to have
+	// muted rather than becoming the listener's.
+	if ( setMuted == muted ) {
+		if ( asFile ) {
+			m_sndFile->ChnSettings[channel].userMuted = false;
+		}
+		return muted ? 1 : 0;
+	}
+	// Both flags, on the channel's settings, the playing channel and its background voices, as
+	// the library's own set_channel_mute_status does. Clearing CHN_MUTE alone, which this did,
+	// left a channel the file mutes silent for good: unmuted to look at, CHN_SYNCMUTE still on.
+	m_sndFile->ChnSettings[channel].dwFlags.set( OpenMPT::CHN_MUTE | OpenMPT::CHN_SYNCMUTE, setMuted );
+	chn.dwFlags.set( OpenMPT::CHN_MUTE | OpenMPT::CHN_SYNCMUTE, setMuted );
+	// A muted channel is not looked at again until it is unmuted, so nothing would tell the OPL
+	// chip to let go of a note the channel was holding: it went on sounding for as long as the
+	// channel stayed muted. Cut here, as the tracker does when a channel is muted; the next note
+	// after it is unmuted sets the voice up again.
+	if ( setMuted && m_sndFile->m_opl ) {
+		m_sndFile->m_opl->NoteCut( static_cast<OpenMPT::CHANNELINDEX>( channel ) );
+	}
+	for ( OpenMPT::CHANNELINDEX i = m_sndFile->GetNumChannels(); i < OpenMPT::MAX_CHANNELS; i++ ) {
+		if ( m_sndFile->m_PlayState.Chn[i].nMasterChn == channel + 1 ) {
+			m_sndFile->m_PlayState.Chn[i].dwFlags.set( OpenMPT::CHN_MUTE | OpenMPT::CHN_SYNCMUTE, setMuted );
+			if ( setMuted && m_sndFile->m_opl ) {
+				m_sndFile->m_opl->NoteCut( i );
+			}
+		}
+	}
+	// Local addition (Exilum Player) - see ModChannelSettings::userMuted.
+	m_sndFile->ChnSettings[channel].userMuted = setMuted && !asFile;
+	return muted ? 1 : 0;
+}
