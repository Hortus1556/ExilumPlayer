+bool OPL::ReadScope(uint8 oplCh, uint64 startFrame, double framesPerColumn, int32 columns, int8 *out) const
+{
+	if(oplCh >= kVoices || m_scope.empty() || out == nullptr || columns <= 0 || !(framesPerColumn > 0.0))
+		return false;
+	const double spanFrames = framesPerColumn * columns;
+	if(!(spanFrames < kScopeFrames / 2))
+		return false;
+	const uint64 span = static_cast<uint64>(spanFrames) + 1;
+	const uint64 head = m_scopeFrames;
+	uint64 start = startFrame;
+	if(start > head || head - start < span)
+		start = head > span ? head - span : 0;
+	// Gone round since: what is there now is a later stretch.
+	if(head - start > kScopeFrames)
+		return false;
+
+	const auto at = [&](int32 column) -> int32
+	{
+		const uint64 frame = start + static_cast<uint64>(column * framesPerColumn);
+		return frame < head ? m_scope[static_cast<size_t>(frame & (kScopeFrames - 1)) * kVoices + oplCh] : 0;
+	};
+	// Fitted to the range, but a voice dying away is not blown up into one at full strength.
+	constexpr int32 quietest = 128;
+	int32 peak = quietest;
+	for(int32 column = 0; column < columns; column++)
+		peak = std::max(peak, std::abs(at(column)));
+	for(int32 column = 0; column < columns; column++)
+		out[column] = static_cast<int8>(std::clamp(at(column) * 127 / peak, -127, 127));
+	return true;
+}
