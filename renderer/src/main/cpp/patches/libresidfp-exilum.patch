+    /**
+     * Local addition (Exilum Player): buffers that receive each voice's own
+     * output alongside the mixed audio, one value for every sample clock()
+     * writes, at the same index. The voice's waveform times its envelope,
+     * through the chip's DACs - before the filter and the master volume -
+     * scaled so a full-scale waveform at full envelope reads about +-32767
+     * (the DACs are normalised: the waveform to about +-0.5, the envelope to 0..1).
+     * nullptr for none, which is the default.
+     */
+    void setVoiceTaps(int16_t* voice1, int16_t* voice2, int16_t* voice3)
+    {
+        voiceTap[0] = voice1;
+        voiceTap[1] = voice2;
+        voiceTap[2] = voice3;
+    }
+
+private:
+    int16_t* voiceTap[3] = { nullptr, nullptr, nullptr };
+
+    /** Writes each voice's output to its tap at [index] - see setVoiceTaps. */
+    void tapVoices(int index)
+    {
+        if (voiceTap[0] == nullptr)
+            return;
+        for (int v = 0; v < 3; v++)
+        {
+            const float out = voice[v].output() * 65534.0f;
+            voiceTap[v][index] = static_cast<int16_t>(out > 32767.0f ? 32767.0f : (out < -32768.0f ? -32768.0f : out));
+        }
+    }
+
