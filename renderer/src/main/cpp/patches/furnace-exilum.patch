         clockDrift=0;
         subticks=0;
         break;
@@ -1562,10 +1562,13 @@ bool DivEngine::nextTick(bool noAccum, bool inhibitLowLat) {
     tickMult=1;
   }
   
-  cycles=got.rate/(divider*tickMult);
-  clockDrift+=fmod(got.rate,(double)(divider*tickMult));
-  if (clockDrift>=(divider*tickMult)) {
-    clockDrift-=(divider*tickMult);
+  // Local change (Exilum Player): the tick clock runs at exilumTempo times the
+  // song's own rate - see exilumTempo in engine.h.
+  const double exilumTickRate=divider*tickMult*exilumTempo;
+  cycles=got.rate/exilumTickRate;
