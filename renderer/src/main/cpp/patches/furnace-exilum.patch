diff --git a/src/engine/engine.h b/src/engine/engine.h
index 27cf900..a623288 100644
--- a/src/engine/engine.h
+++ b/src/engine/engine.h
@@ -675,8 +675,18 @@ class DivEngine {
   friend class DivExportSAPR;
   friend class DivExportTiuna;
   friend class DivExportZSM;
+  // Local addition (Exilum Player): the Android player's bridge, which seeks,
+  // measures subsongs and sets up a headless engine through members that are
+  // otherwise private. See decoder-furnace.cpp.
+  friend class ExilumFurnaceBridge;
 
   public:
+    // Local addition (Exilum Player): how much faster than the song asks the
+    // ticks come, 1 for as written. Only the tick clock uses it - the chips
+    // still produce audio at the output rate - so the song gets faster or
+    // slower and its pitch stays where it is. Song time (totalSeconds and
+    // totalTicks) keeps counting at the song's own rate.
+    double exilumTempo=1.0;
     DivSong song;
     DivOrders* curOrders;
     DivChannelData* curPat;
